def ResourceObservation.Upward.{u} : {M : Type u} → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} le U => ∀ ⦃x y : M⦄, U x → le x y → U y
def ResourceObservation.Product.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → ResourceObservation.Profile.{u} M → M → Prop :=
fun {M} add le U V b => @Exists.{u + 1} M fun x => @Exists.{u + 1} M fun y => And (U x) (And (V y) (le (add x y) b))
def ResourceObservation.ObservedFactorDomination.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} add le B =>
  ∀ (b : M),
    B b →
      ∀ (x y : M),
        le (add x y) b →
          @Exists.{u + 1} M fun a =>
            @Exists.{u + 1} M fun c => And (B a) (And (B c) (And (le x a) (And (le y c) (le (add a c) b))))
def ResourceObservation.UniversalProductAgreement.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} add le B =>
  ∀ (U U' V V' : ResourceObservation.Profile.{u} M),
    @ResourceObservation.Upward.{u} M le U →
      @ResourceObservation.Upward.{u} M le U' →
        @ResourceObservation.Upward.{u} M le V →
          @ResourceObservation.Upward.{u} M le V' →
            @ResourceObservation.AgreeOn.{u} M B U U' →
              @ResourceObservation.AgreeOn.{u} M B V V' →
                @ResourceObservation.AgreeOn.{u} M B (@ResourceObservation.Product.{u} M add le U V)
                  (@ResourceObservation.Product.{u} M add le U' V')
def ResourceObservation.UniversalRestrictionExact.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} add le B =>
  ∀ (U V : ResourceObservation.Profile.{u} M),
    @ResourceObservation.Upward.{u} M le U →
      @ResourceObservation.Upward.{u} M le V →
        ∀ (b : M),
          B b →
            Iff (@ResourceObservation.Product.{u} M add le U V b)
              (@ResourceObservation.Product.{u} M add le (@ResourceObservation.Restrict.{u} M B U)
                (@ResourceObservation.Restrict.{u} M B V) b)
