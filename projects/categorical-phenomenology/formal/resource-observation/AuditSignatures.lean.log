fun {M} add le U V b => Exists.{u + 1} fun x => Exists.{u + 1} fun y => U x ∧ V y ∧ le (add x y) b
def ResourceObservation.ObservedFactorDomination.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} add le B =>
  ∀ (b : M),
    B b →
      ∀ (x y : M),
        le (add x y) b → Exists.{u + 1} fun a => Exists.{u + 1} fun c => B a ∧ B c ∧ le x a ∧ le y c ∧ le (add a c) b
def ResourceObservation.UniversalProductAgreement.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} add le B =>
  ∀ (U U' V V' : ResourceObservation.Profile.{u} M),
    ResourceObservation.Upward.{u} le U →
      ResourceObservation.Upward.{u} le U' →
        ResourceObservation.Upward.{u} le V →
          ResourceObservation.Upward.{u} le V' →
            ResourceObservation.AgreeOn.{u} B U U' →
              ResourceObservation.AgreeOn.{u} B V V' →
                ResourceObservation.AgreeOn.{u} B (ResourceObservation.Product.{u} add le U V)
                  (ResourceObservation.Product.{u} add le U' V')
def ResourceObservation.UniversalRestrictionExact.{u} : {M : Type u} →
  (M → M → M) → (M → M → Prop) → ResourceObservation.Profile.{u} M → Prop :=
fun {M} add le B =>
  ∀ (U V : ResourceObservation.Profile.{u} M),
    ResourceObservation.Upward.{u} le U →
      ResourceObservation.Upward.{u} le V →
        ∀ (b : M),
          B b →
            (ResourceObservation.Product.{u} add le U V b ↔
              ResourceObservation.Product.{u} add le (ResourceObservation.Restrict.{u} B U)
                (ResourceObservation.Restrict.{u} B V) b)
