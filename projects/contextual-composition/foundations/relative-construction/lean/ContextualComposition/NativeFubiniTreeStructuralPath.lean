module
public import ContextualComposition.NativeFubiniTreeUnit
@[expose] public section

/-! Morphisms generated by independent structural moves are evaluated on
the separate and joint trees without using Fubini to construct either. -/
namespace ContextualComposition.NativeFinitePush.DependentFibre.RigGridNativeAdapter
open CategoryTheory MonoidalCategory ContextualComposition.RigGrid
open scoped MonoidalCategory
universe u v
variable {C : Type u} [cat : Category.{v} C]
variable {T : Bi (coeff (C:=C))} {I : C} {S : Bi (coeff (C:=C))} {Z : C}

structure FubiniTreeLaws (R : Gather S T Z) (J : UnitCompat R I) (P : TensorPrimitive T) (m : Middle T I) : Prop where
  regroup : MedialRegroup P m
  swap : MedialSwap P m
  runit : MedialRightUnit R J m

set_option backward.isDefEq.respectTransparency false in
theorem standardFubiniTreeLaws (mul : MonoidalCategory C) (symm : @SymmetricCategory C cat mul)
    (R : Gather S (binary (@Binary.ofMonoidal C cat mul)) Z)
    (J : UnitCompat R (@MonoidalCategoryStruct.tensorUnit C cat mul.toMonoidalCategoryStruct))
    (h : ∀ a : C, J.ρ a = (@MonoidalCategoryStruct.rightUnitor C cat mul.toMonoidalCategoryStruct a).hom) :
    FubiniTreeLaws R J (@tensorPrimitives C cat mul symm.toBraidedCategory)
      (additiveMiddle (@Additive.ofBraided C cat mul symm.toBraidedCategory)) :=
  ⟨standardMedialRegroup mul symm.toBraidedCategory, standardMedialSwap mul symm,
    standardMedialRightUnit mul symm.toBraidedCategory R J h⟩

namespace DependentFubiniTree
open OrderedDependentAugData
variable [MonoidalCategory C] [SymmetricCategory C]
local notation "ℙ" => standardPush (C:=C)
variable (R : Gather (binary (Additive.ofBraided (C:=C)).sum) T (𝟙_ C))
variable (L : LeftGather (binary (Additive.ofBraided (C:=C)).sum) T (𝟙_ C))
variable (J : UnitCompat R I)
variable (N : GridBinary (symmetricCross (C:=C)) R L) (NR : GatherOuterNat R) (NL : GatherLeftNat L)
variable [lF : ∀ a : C, (leftFactor T a).LaxBraided] [rF : ∀ b : C, (rightFactor (T:=T) b).LaxBraided]
variable (hl : ∀ a : C, SameLeftGather T a L) (hr : ∀ b : C, SameRightGather R b)
variable (P : TensorPrimitive T) (Q : PrimitiveLinearity R L P) (U : AssocRightUnit R J P)
variable (ia : ∀ a b c, IsIso (P.assoc a b c))
variable (swap_unit : P.swap I I ≫ J.ρ I = J.ρ I)
variable (is : ∀ a b, IsIso (P.swap a b))
variable (iu : ∀ a, IsIso (J.ρ a))

inductive StructuralMove : DependentFubiniTree I → DependentFubiniTree I → Type _ where
  | assoc {a b : DependentFubiniTree I} : AssocMove a b → StructuralMove a b
  | swap (a b : DependentFubiniTree I) : StructuralMove (.fork a b) (.fork b a)
  | eraseRight (a : DependentFubiniTree I) : StructuralMove (.fork a .unit) a
  | left {a b : DependentFubiniTree I} (p : StructuralMove a b) (c : DependentFubiniTree I) :
      StructuralMove (.fork a c) (.fork b c)
  | right (c : DependentFubiniTree I) {a b : DependentFubiniTree I} (p : StructuralMove a b) :
      StructuralMove (.fork c a) (.fork c b)

local notation "inp" => jointInput R L J
local notation "sep" => separate R L J
local notation "acc" => accumulate R L J
local notation "ni" => independentAugIso R L (J.ρ I) N NR NL hl hr
local notation "rp" => ReadComparison.product R L J NR NL hl hr
local notation "rc" => ReadComparison.accumulate R L J NL hl

noncomputable def StructuralMove.joint {a b : DependentFubiniTree I} (p : StructuralMove a b) :
    ReadComparison (inp a) (inp b) :=
  match p with
  | .assoc f => f.joint R L J NR NL hl hr P Q U ia
  | .swap a b => jointSwapComparison R L J P N Q swap_unit is (inp a) (inp b)
  | .eraseRight a => jointRightUnitComparison R L J hl iu (inp a)
  | .left q c => rp q.joint (identityRead (inp c))
  | .right c q => rp (identityRead (inp c)) q.joint

noncomputable def StructuralMove.separateIso {a b : DependentFubiniTree I} (p : StructuralMove a b) :
    NativeAugmentedIso (sep a) (sep b) :=
  match p with
  | .assoc f => f.separateIso R L J N NR NL hl hr P Q U ia
  | .swap a b => separateSwapIso P R L J N Q swap_unit is a b
  | .eraseRight a => separateRightUnitIso R L J hl iu a
  | .left q c => ni q.separateIso (NativeAugmentedIso.ident (sep c))
  | .right c q => ni (NativeAugmentedIso.ident (sep c)) q.separateIso

variable (m : Middle T I) (mi : MiddleInv m) (h : MedialLinear m R L) (j : MedialInner m R L)
variable (unit_middle : m.cell I I I I ≫ unitCollapse R J = unitCollapse R J)
variable [IsIso (J.ρ I)]
local notation "ph" => comparison R L J N NR NL hl hr m mi h j unit_middle
local notation "rs" => StructuralMove.separateIso R L J N NR NL hl hr P Q U ia swap_unit is iu
local notation "rj" => StructuralMove.joint R L J N NR NL hl hr P Q U ia swap_unit is iu

set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 5000000 in
theorem StructuralMove.fubini {a b : DependentFubiniTree I} (p : StructuralMove a b)
    (law : FubiniTreeLaws R J P m) :
    (rs p).hom.comp (ph b).hom = (ph a).hom.comp (rc (rj p)).hom := by
  induction p with
  | assoc p => exact p.fubini R L J N NR NL hl hr P Q U ia m mi h j unit_middle law.regroup
  | swap a b => exact comparison_swap P m R L J N NR NL Q hl hr swap_unit is a b mi h j unit_middle law.swap
  | eraseRight a => exact comparison_runit R L J N NR NL hl hr iu a m mi h j unit_middle law.runit
  | left q c ih =>
    have id₀ : (AugHom.ident (sep c)).comp (ph c).hom = (ph c).hom.comp (rc (identityRead (inp c))).hom := by
      rw [identityRead_accumulate R L J NL hl]
      exact (AugHom.ident_comp _).trans (AugHom.comp_ident _).symm
    exact comparison_fork_congr R L J N NR NL hl hr m mi h j unit_middle _ _ _ _ ih id₀
  | right c q ih =>
    have id₀ : (AugHom.ident (sep c)).comp (ph c).hom = (ph c).hom.comp (rc (identityRead (inp c))).hom := by
      rw [identityRead_accumulate R L J NL hl]
      exact (AugHom.ident_comp _).trans (AugHom.comp_ident _).symm
    exact comparison_fork_congr R L J N NR NL hl hr m mi h j unit_middle _ _ _ _ id₀ ih

set_option backward.isDefEq.respectTransparency false in
theorem StructuralMove.fubini_inv {a b : DependentFubiniTree I} (p : StructuralMove a b)
    (law : FubiniTreeLaws R J P m) :
    (rs p).inv.comp (ph a).hom = (ph b).hom.comp (rc (rj p)).inv := by
  let x := rs p
  let y := rc (rj p)
  let a₀ := (ph a).hom
  let b₀ := (ph b).hom
  have e : x.hom.comp b₀ = a₀.comp y.hom :=
    StructuralMove.fubini R L J N NR NL hl hr P Q U ia swap_unit is iu m mi h j unit_middle p law
  change x.inv.comp a₀ = b₀.comp y.inv
  calc
    _ = (x.inv.comp a₀).comp (y.hom.comp y.inv) := by rw [y.hom_inv, AugHom.comp_ident]
    _ = x.inv.comp ((a₀.comp y.hom).comp y.inv) := by rw [AugHom.comp_assoc, AugHom.comp_assoc]
    _ = _ := by rw [← e, ← AugHom.comp_assoc x.inv, ← AugHom.comp_assoc x.inv, x.inv_hom, AugHom.ident_comp]

/-- Finite composable addressed structural moves, distinguished even if
the actual interpreted coefficient labels coincide. -/
inductive StructuralPath : DependentFubiniTree I → DependentFubiniTree I → Type _ where
  | ident (a : DependentFubiniTree I) : StructuralPath a a
  | next {a b c : DependentFubiniTree I} (p : StructuralMove a b) (q : StructuralPath b c) : StructuralPath a c
  | prev {a b c : DependentFubiniTree I} (p : StructuralMove b a) (q : StructuralPath b c) : StructuralPath a c

def StructuralPath.eraseLeft (a : DependentFubiniTree I) : StructuralPath (.fork .unit a) a :=
  .next (.swap .unit a) (.next (.eraseRight a) (.ident a))

noncomputable def StructuralPath.separateIso {a b : DependentFubiniTree I} (p : StructuralPath a b) :
    NativeAugmentedIso (sep a) (sep b) :=
  match p with
  | .ident _ => NativeAugmentedIso.ident _
  | .next f g => (rs f).trans g.separateIso
  | .prev f g => (rs f).reverse.trans g.separateIso

noncomputable def StructuralPath.jointIso {a b : DependentFubiniTree I} (p : StructuralPath a b) :
    NativeAugmentedIso (acc (inp a)) (acc (inp b)) :=
  match p with
  | .ident _ => NativeAugmentedIso.ident _
  | .next f g => (rc (rj f)).trans g.jointIso
  | .prev f g => (rc (rj f)).reverse.trans g.jointIso

local notation "ps" => StructuralPath.separateIso R L J N NR NL hl hr P Q U ia swap_unit is iu
local notation "pj" => StructuralPath.jointIso R L J N NR NL hl hr P Q U ia swap_unit is iu

set_option backward.isDefEq.respectTransparency false in
theorem StructuralPath.fubini {a b : DependentFubiniTree I} (p : StructuralPath a b)
    (law : FubiniTreeLaws R J P m) :
    (ps p).hom.comp (ph b).hom = (ph a).hom.comp (pj p).hom := by
  induction p with
  | ident a => exact (AugHom.ident_comp _).trans (AugHom.comp_ident _).symm
  | @next a b c f g ih =>
    have h₀ := f.fubini R L J N NR NL hl hr P Q U ia swap_unit is iu m mi h j unit_middle law
    change ((rs f).hom.comp (ps g).hom).comp (ph c).hom = (ph a).hom.comp ((rc (rj f)).hom.comp (pj g).hom)
    rw [AugHom.comp_assoc, ih, ← AugHom.comp_assoc, h₀, AugHom.comp_assoc]
  | @prev a b c f g ih =>
    have h₀ := f.fubini_inv R L J N NR NL hl hr P Q U ia swap_unit is iu m mi h j unit_middle law
    change ((rs f).inv.comp (ps g).hom).comp (ph c).hom = (ph a).hom.comp ((rc (rj f)).inv.comp (pj g).hom)
    rw [AugHom.comp_assoc, ih, ← AugHom.comp_assoc, h₀, AugHom.comp_assoc]

end DependentFubiniTree
end ContextualComposition.NativeFinitePush.DependentFibre.RigGridNativeAdapter
