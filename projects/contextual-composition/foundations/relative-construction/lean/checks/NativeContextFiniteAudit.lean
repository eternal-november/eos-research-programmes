open ContextualComposition.NativeFinitePush.DependentFibre.RigGridNativeAdapter

open CategoryTheory

universe u v
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C] {I : C}

open MonoidalCategory
open scoped MonoidalCategory
example : ¬ Function.Surjective (mergeUnitNative (C:=C)).addr :=
  mergeUnit_not_surjective
example : ContextualComposition.NativeFinitePush.fibreList (mergeUnitNative (C:=C)).addr (1 : Fin 2) = [] :=
  mergeUnit_empty_fibre
example (A : NativeDependentPair I) (x : A.ordered.X) : (⟨none⟩ : A.ChildTag) ∉ A.ordered.us x :=
  A.child_dummy_absent x
