open ContextualComposition.NativeFinitePush.DependentFibre.RigGridNativeAdapter

open CategoryTheory

universe u v
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C] {I : C}

open IndexedNativeFamily

example (A : Type u) (K : NativeProjectionClass.{u}) :
    OrderedAdmissible (C:=C) (I:=I) (fun _ : A => OrderedDependentAugData.unit I) K :=
  orderedUnit_admissible K

example (K : NativeProjectionClass.{u}) (A : Type u) (P : AdmissibleDependentInput K A I) :
    OrderedAdmissible P.ordered K :=
  P.ordered_admissible
