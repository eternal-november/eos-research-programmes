evaluationUnit splitEndpoints presheaf Bool
  wholeZ : (SpanPull.All.evaluationBase splitEndpoints presheaf (𝟙 Bool)).hom.app wholeZ ≫
    (eqToHom ⋯).app ((CoproductSpan.All.evaluation splitEndpoints presheaf Bool).functor.obj wholeZ) =
  (CoproductSpan.All.evaluation splitEndpoints presheaf Bool).functor.map
    ((wholeUnit splitEndpoints presheaf Bool).app wholeZ)
evaluationComp splitEndpoints presheaf collapse (selectPoint true)
  wholeZ : (SpanPull.All.evaluationBase splitEndpoints presheaf (collapse ≫ selectPoint true)).hom.app wholeZ ≫
    (eqToHom ⋯).app ((CoproductSpan.All.evaluation splitEndpoints presheaf Bool).functor.obj wholeZ) =
  (CoproductSpan.All.evaluation splitEndpoints presheaf Bool).functor.map
      ((wholeComp splitEndpoints presheaf collapse (selectPoint true)).app wholeZ) ≫
    (SpanPull.All.evaluationBase splitEndpoints presheaf collapse).hom.app
        ((SpanPull.All.pull splitEndpoints presheaf (selectPoint true)).obj wholeZ) ≫
      (Iterates.packedMap endpoints splitEndpoints presheaf collapse.op).map
        ((SpanPull.All.evaluationBase splitEndpoints presheaf (selectPoint true)).hom.app wholeZ)
