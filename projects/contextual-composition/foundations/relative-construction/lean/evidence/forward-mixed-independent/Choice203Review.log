ForwardMixed.strictCell P P C T (𝟙 B.pt) false
  (z
    false) : (SpanPull.strictTag P P Y B.pt false).map
    ((PayloadLift.square T (P false) (P false) (C false) (𝟙 B.pt)).hom.app (z false)) =
  (PayloadLift.square T (Sigma.desc P) (Sigma.desc P) (SpanPull.choice P C) (𝟙 B.pt)).hom.app
    ((SpanPull.strictTag P P Y B.pt false).obj (z false))
ForwardMixed.strictCell P P C T (𝟙 B.pt) true
  (z
    true) : (SpanPull.strictTag P P Y B.pt true).map
    ((PayloadLift.square T (P true) (P true) (C true) (𝟙 B.pt)).hom.app (z true)) =
  (PayloadLift.square T (Sigma.desc P) (Sigma.desc P) (SpanPull.choice P C) (𝟙 B.pt)).hom.app
    ((SpanPull.strictTag P P Y B.pt true).obj (z true))
