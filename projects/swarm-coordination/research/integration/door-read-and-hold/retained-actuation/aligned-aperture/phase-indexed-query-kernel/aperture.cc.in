#include <algorithm>
#include <cassert>
#include <cmath>
#include <iostream>
#include <map>
#include <memory>
#include <string>
#include <vector>
#include "utils.hpp"
using namespace rmf_building_sim_gz_plugins;
namespace rmf_door_msgs::msg {
struct Time {
  int sec=0, nanosec=0;
  bool operator==(Time const&) const=default;
};
struct DoorMode {
  enum {MODE_OPEN=1,MODE_CLOSED,MODE_MOVING};
  int value=0;
  bool operator==(DoorMode const&) const=default;
};
struct DoorState {
  using SharedPtr=std::shared_ptr<DoorState>;
  std::string door_name;
  Time door_time;
  DoorMode current_mode;
  bool operator==(DoorState const&) const=default;
};
struct Session {std::string requester_id;Time request_time;};
struct DoorSessions {
  std::string door_name;
  std::vector<Session> sessions;
};
struct SupervisorHeartbeat {
  using SharedPtr=std::shared_ptr<SupervisorHeartbeat>;
  std::vector<DoorSessions> all_sessions;
  Time time;
};
}
using namespace rmf_door_msgs::msg;
using Entity=int;
const Entity kNullEntity=0;
#define gzwarn std::cerr
namespace components {
struct JointVelocityCmd {};
struct JointPosition {
 std::vector<double> data;
 const std::vector<double>& Data() const {return data;}
};
}
struct EntityComponentManager {
 std::map<std::pair<Entity,std::string>,Entity> names;
 std::map<Entity,components::JointPosition> positions;
 std::map<Entity,double> written;
 template<class T> void SetComponentData(Entity j, std::vector<double> xs){
  static_assert(std::is_same_v<T,components::JointVelocityCmd>);
  assert(xs.size()==1);written[j]=xs[0];
 }
 Entity ParentEntity(Entity) const {return 20;}
 template<class T> const T* Component(Entity j) const {
    return &positions.at(j);
 }
};
struct Model {
 Entity id;
 Model(Entity x):id(x){}
 Entity JointByName(const EntityComponentManager& cm,const std::string& name) const {
    const auto x=cm.names.find({id,name});
    return x==cm.names.end()?kNullEntity:x->second;
 }
};
enum class DoorModeCmp {OPEN,CLOSE,MOVING};
struct DoorData {
 struct Joint {std::string name;double open_position,closed_position;};

 std::vector<Joint> joints;
 MotionParams params;
};
struct Publisher {
  DoorState record;
  void publish(DoorState s){record=std::move(s);}
};
struct Gz {
  Publisher sink,*_door_state_pub=&sink;
JOINT_SRC
WITHIN_SRC
MODE_SRC
TARGET_SRC
COMMAND_SRC
PUBLISH_SRC
  std::map<Entity,double> _last_cmd_vel;
};
struct LegacyTask {
 struct StatusMsg {
  enum {STATE_ACTIVE,STATE_COMPLETED};
  int state=STATE_ACTIVE;
  std::string status;
 };
};
struct DoorOpen {struct ActivePhase {
 std::string _door_name="gate",_request_id="crew";
 LegacyTask::StatusMsg _status;
 void _update_status(const DoorState::SharedPtr&,const SupervisorHeartbeat::SharedPtr&);
};};
SESSION_SRC
UPDATE_SRC

bool phase(const DoorState& report,const SupervisorHeartbeat& hb){
 DoorOpen::ActivePhase p;
 p._update_status(std::make_shared<DoorState>(report),std::make_shared<SupervisorHeartbeat>(hb));
 return p._status.state==LegacyTask::StatusMsg::STATE_COMPLETED;
}
bool exact_known_open(const Gz&gz,Entity e,const EntityComponentManager& cm,const DoorData& door){
  if(door.joints.empty()) return false;
  for(const auto&j:door.joints){
    const auto id=gz.get_joint_entity(cm,e,j.name);
    if(id==kNullEntity || !gz.is_joint_at_position(
        cm.Component<components::JointPosition>(id)->Data()[0],door.params.dx_min,j.open_position))
      return false;
  }
  return true;
}

constexpr double dt=1./8;
const MotionParams params{.v_max=1./4,.a_max=1./8,.a_nom=1./8,.dx_min=1./64};
DoorData leaf(std::string name){return {{{name,1.,0.}},params};}
int main(){
 // The stock function takes one target for all the joints in a DoorData.
 // Use separately addressable one-joint models, not a stock per-leaf API.
 auto left=leaf("left"); auto other=leaf("other");
 const SupervisorHeartbeat hb={{{"gate",{{"crew",{8,0}}}}},{9,0}};
 for(int back=0;back<=6;++back)
 for(int start:{0,1,3,5,7,9,11,13})
 for(int duration:{0,1,2,3,4}){
   if(duration==0&&start!=0)continue;
   if(duration!=0&&start==0)continue;
   Gz g;
   EntityComponentManager pose;
   pose.names={{{10,"left"},1},{{11,"other"},2}};
   pose.positions={{1,{{1.}}},{2,{{1.}}}};
   for(int j=0;j<back;++j)g.command_door(10,pose,left,dt,DoorModeCmp::CLOSE);
   // Truthful read at tick zero, conditioned on the modeled clamped open pose;
   // the preceding frozen sample creates retained limiter-state diversity.
   assert(exact_known_open(g,10,pose,left));
   assert(g.get_current_mode(10,pose,left)==DoorModeCmp::OPEN);
   g.publish_state(9,"gate",g.get_current_mode(10,pose,left));
   assert(phase(g.sink.record,hb));
   std::cout<<back<<' '<<start<<' '<<duration;
   for(int t=1;t<=24;++t){
     auto& x=pose.positions.at(1).data[0];
     const auto target=(start<=t&&t<start+duration)?DoorModeCmp::CLOSE:DoorModeCmp::OPEN;
     g.command_door(10,pose,left,dt,target);
     g.command_door(11,pose,other,dt,DoorModeCmp::CLOSE);
     const double u=pose.written.at(1),bv=pose.written.at(2);
     auto& bx=pose.positions.at(2).data[0];
     assert(x+dt*u>0.); // no lower stop, to justify endpoint maximum
     x=std::clamp(x+dt*u,0.,1.);
     bx=std::clamp(bx+dt*bv,0.,1.);
     double debt=(1.-x)*1024.;
     assert(debt==std::floor(debt));
     assert(bv<0. && bx<1.);
     std::cout<<' '<<int(debt);
   }
   std::cout<<'\n';
 }
}
